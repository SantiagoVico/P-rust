export component ClipboardCard inherits Rectangle {
    in property <string> text-content;
    
    callback on-copy();
    callback on-delete(); 
    
    property <bool> expanded: false;
    property <bool> is-long: text-node.preferred-height > 60px;
    property <bool> confirming-delete: false; // État pour la confirmation de suppression
    
    background: #2a2a3599;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff10;
    
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        
        Rectangle {
            clip: true; 
            height: (root.is-long && !root.expanded) ? 60px : text-node.preferred-height;
            
            text-node := Text {
                width: 100%;
                height: self.preferred-height;
                text: root.text-content;
                color: #e2e2e2;
                font-size: 14px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
        
        HorizontalLayout {
            alignment: space-between;
            
            // Bouton d'extension (Voir plus / moins)
            HorizontalLayout {
                Rectangle {
                    visible: root.is-long;
                    width: 80px;
                    height: 32px;
                    background: touch-expand.has-hover ? #ffffff22 : transparent;
                    border-radius: 6px;
                    
                    Text {
                        text: root.expanded ? "Voir moins ▲" : "Voir plus ▼";
                        color: #a0a0b0;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    touch-expand := TouchArea {
                        clicked => { root.expanded = !root.expanded; }
                    }
                }
            }
            
            // Actions directes (Supprimer avec confirmation & Copier)
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                
                // Bouton Supprimer (S'élargit et demande confirmation au 1er clic)
                Rectangle {
                    background: touch-delete.has-hover ? #e24a4aaa : #e24a4a55;
                    border-radius: 8px;
                    width: root.confirming-delete ? 95px : 32px; 
                    height: 32px;
                    
                    // Animation fluide de l'élargissement du bouton de confirmation
                    animate width { duration: 150ms; easing: ease-in-out; }
                    
                    Text { 
                        text: root.confirming-delete ? "Supprimer ?" : "✖"; 
                        font-size: root.confirming-delete ? 12px : 14px; 
                        color: white; 
                        horizontal-alignment: center; 
                        vertical-alignment: center; 
                    }
                    
                    touch-delete := TouchArea { 
                        clicked => { 
                            if (!root.confirming-delete) {
                                root.confirming-delete = true;
                            } else {
                                root.on-delete(); 
                            }
                        } 
                    }
                }
                
                // Bouton Copier
                Rectangle {
                    background: touch-copy.has-hover ? #4a90e2aa : #4a90e255; 
                    border-radius: 8px;
                    width: 32px; height: 32px;
                    Text { text: "📋"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    touch-copy := TouchArea { clicked => { root.on-copy(); } }
                }
            }
        }
    }
}