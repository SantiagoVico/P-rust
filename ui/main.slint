import { ScrollView } from "std-widgets.slint";
import { ClipboardCard } from "clipboard_card.slint";
import { SearchBar } from "search_bar.slint";

export component AppWindow inherits Window {
    preferred-width: 450px;
    preferred-height: 650px;
    title: "Paste Clone";
    
    background: @radial-gradient(circle, #352538 0%, #15151a 80%, #0d0d12 100%);
    
    in property <[string]> history;
    
    callback copy-item(string);
    callback delete-item(int, string);
    callback search-changed(string); 
    
    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        
        search-bar := SearchBar {
            search-changed(text) => {
                root.search-changed(text);
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 15px;
                alignment: start;
                
                for item[index] in root.history : ClipboardCard {
                    text-content: item;
                    
                    on-copy => { root.copy-item(item); }
                    on-delete => { root.delete-item(index, item); }
                }
            }
        }
    }
}